{
    "name": "nick/cron-runner",
    "type": "library",
    "require": {
        "php": "^8.4",
        "crunzphp/crunz": "~3.9.0",
        "symfony/lock": "^7.0",
        "laravel/framework": "~12.73.0",
        "dragonmantank/cron-expression": "^3.6",
        "laravel/serializable-closure": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.0"
    },
    "autoload": {
        "psr-4": {
            "CronRunner\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "CronRunner\\Tests\\": "tests/"
        }
    },
    "config": {
        "platform": {
            "php": "8.4.28"
        }
    }
}
